# --- Encryption (required) ---
# Generate once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=paste_generated_fernet_key_here

# --- JWT session signing (required) ---
# Any long random string — used to sign user login sessions.
JWT_SECRET_KEY=choose_a_long_random_jwt_secret

# --- Admin-lite API (required to manage the shared key pool via /admin/keys) ---
ADMIN_TOKEN=choose_a_long_random_admin_token

# --- Redis (optional) ---
# If not set, usage counters fall back to in-memory (fine for local
# single-process testing). Use a real Redis (e.g. Upstash free tier) once
# you run more than one backend worker.
REDIS_URL=

# --- How often to auto-check all shared-pool keys for validity (hours) ---
KEY_CHECK_INTERVAL_HOURS=3

# --- Per-user daily fair-use cap on the SHARED pool ---
# Once a user hits this many messages in a UTC day, they're prompted to
# add their own key (BYOK) instead of getting an error.
DEFAULT_DAILY_QUOTA=20

# Note: provider API keys for the shared pool are added via /admin/keys,
# not here — see README. Users add their own personal keys via /user/keys
# from inside the app itself.
